+void EventBase::report_parent() const {
+    // NCCL's proxy thread inserts children (KernelCh events) while the user thread stops the collective and walks
+    // the tree here: both under the context's tree mutex (recursive: report_parent recurses to the root)
+    std::lock_guard lock(ctx->tree_mtx);
+    if (parentObj) {
+        return static_cast<EventBase *>(parentObj)->report_parent();
+    }
+    report_children();
+}
